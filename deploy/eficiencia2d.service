[Unit]
Description=Eficiencia2D Backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
# Ajustar User/Group y WorkingDirectory a la ruta real del checkout en la VM.
User=www-data
Group=www-data
WorkingDirectory=/opt/eficiencia2D-backend
EnvironmentFile=/opt/eficiencia2D-backend/.env
# Datos temporales fuera del checkout (persisten entre deploys); crear con permisos del User.
Environment=DATA_DIR=/var/lib/eficiencia2d
# uvicorn del venv. --port 80 requiere privilegio: se concede abajo con AmbientCapabilities
# (así el servicio corre como www-data y aun así puede bindear el puerto 80).
ExecStart=/opt/eficiencia2D-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 80 --workers 1
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
